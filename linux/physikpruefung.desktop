[Desktop Entry]
Type=Application
Name=Physikprüfung
Comment=Prüfungsaufgaben auswählen, PDFs erzeugen und in Git committen
TryExec=~/.local/bin/pruefung
Exec=~/.local/bin/pruefung --background
Path=$TYPST_ROOT/pruefung
Icon=applications-science
Terminal=false
Categories=Education;
Keywords=physik;prüfung;pruefung;typst;aufgaben;prüfungsaufgaben;streamlit;
StartupNotify=false
Actions=Stop;

[Desktop Action Stop]
Name=Hintergrundserver beenden
Exec=~/.local/bin/pruefung --stop
